<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <!-- TEST Id for central-deployment testing only.
       Production / AppSource Id: 410c6ad1-80fb-47ad-888e-7bb2c98b7f35
       Restore the production Id before resubmitting to AppSource. -->
  <Id>08176fd2-4a1c-4c37-87ce-b9c418439597</Id>
  <Version>1.0.0.9</Version>
  <ProviderName>Checkmark Plagiarism</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Checkmark Plagiarism (TEST)"/>
  <Description DefaultValue="Checkmark Plagiarism — test build for LaunchEvent fix"/>
  <IconUrl DefaultValue="https://office.checkmarkplagiarism.com/add-in/assets/icon-32.png?v=2"/>
  <HighResolutionIconUrl DefaultValue="https://office.checkmarkplagiarism.com/add-in/assets/icon-64.png?v=2"/>
  <SupportUrl DefaultValue="https://office.checkmarkplagiarism.com/help"/>
  <AppDomains>
    <AppDomain>https://www.checkmarkplagiarism.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="SharedRuntime" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://office.checkmarkplagiarism.com/add-in/taskpane/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long" />
          <!-- Dedicated runtime for the OnDocumentOpened LaunchEvent.
               Per Microsoft's canonical sample (word-add-label-on-open),
               LaunchEvent's <SourceLocation> resid must match a <Runtime resid>
               declared here, with an <Override type="javascript"> pointing at
               the JS handler file. No lifetime attribute — defaults work. -->
          <Runtime resid="LaunchEvent.Url">
            <Override type="javascript" resid="LaunchEvent.Js"/>
          </Runtime>
        </Runtimes>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Office.AutoShowTaskpaneWithDocument</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <ExtensionPoint xsi:type="LaunchEvent">
            <LaunchEvents>
              <LaunchEvent Type="OnDocumentOpened" FunctionName="onDocumentOpened" />
            </LaunchEvents>
            <SourceLocation resid="LaunchEvent.Url"/>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://office.checkmarkplagiarism.com/add-in/assets/icon-16.png?v=2"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://office.checkmarkplagiarism.com/add-in/assets/icon-32.png?v=2"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://office.checkmarkplagiarism.com/add-in/assets/icon-80.png?v=2"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://go.microsoft.com/fwlink/?LinkId=276812"/>
        <bt:Url id="Commands.Url"     DefaultValue="https://office.checkmarkplagiarism.com/add-in/commands/commands.html?v=4"/>
        <bt:Url id="Taskpane.Url"     DefaultValue="https://office.checkmarkplagiarism.com/add-in/taskpane/taskpane.html?v=4"/>
        <bt:Url id="LaunchEvent.Url"  DefaultValue="https://office.checkmarkplagiarism.com/add-in/launch/launch.html?v=4"/>
        <bt:Url id="LaunchEvent.Js"   DefaultValue="https://office.checkmarkplagiarism.com/add-in/launch/launch.js?v=4"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Start Checkmark Plagiarism before you begin writing!"/>
        <bt:String id="CommandsGroup.Label" DefaultValue="Checkmark Plagiarism"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Checkmark Plagiarism"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Your add-in loaded successfully. Go to the HOME tab and click the 'Show Task Pane' button to get started."/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Click to Show a Taskpane"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
